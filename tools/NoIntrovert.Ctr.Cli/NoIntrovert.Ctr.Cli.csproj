<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ni3ds</AssemblyName>
    <RootNamespace>NoIntrovert.Ctr.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Installable with `dotnet tool install -g NoIntrovert.Ctr.Cli`; standalone binaries come from the release workflow. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>NoIntrovert.Ctr.Cli</PackageId>
    <ToolCommandName>ni3ds</ToolCommandName>
    <Description>ni3ds: command-line tool for Nintendo 3DS files built on NoIntrovert.Ctr. Show key status and file info, decrypt, convert CCI ↔ CIA, build CIAs from CDN folders, trim and untrim, verify against No-Intro DATs and rename.</Description>
    <PackageTags>3ds;nintendo-3ds;cia;cci;cdn;cli;dotnet-tool</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NoIntrovert.Ctr\NoIntrovert.Ctr.csproj" />
  </ItemGroup>
</Project>
