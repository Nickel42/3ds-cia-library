<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>3ds-kit</AssemblyName>
    <RootNamespace>Lib3dsKit.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Installable with `dotnet tool install -g lib-3ds-kit.Cli`; standalone binaries come from the release workflow. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>lib-3ds-kit.Cli</PackageId>
    <ToolCommandName>3ds-kit</ToolCommandName>
    <Description>3ds-kit: command-line tool for converting and decrypting Nintendo 3DS files, built on lib-3ds-kit. Show key status and file info, decrypt, convert CCI ↔ CIA, build CIAs from CDN folders, trim and untrim, and check internal hashes.</Description>
    <PackageTags>3ds;nintendo-3ds;cia;cci;cdn;decrypt;cli;dotnet-tool</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\lib-3ds-kit\lib-3ds-kit.csproj" />
  </ItemGroup>
</Project>
